{
  "builds": [
    {
      "src": "api/download.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/download(.*)",
      "dest": "api/download.py"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
